<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#A7F3D0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#0B1116</item>
        <item name="android:navigationBarColor">#0B1116</item>
        <item name="android:statusBarColor">#0B1116</item>
    </style>
    <style name="CoverTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="SettingsTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#006F95</item>
        <item name="android:windowBackground">#F5F9FD</item>
        <item name="android:statusBarColor">#C1EAFB</item>
        <item name="android:navigationBarColor">#F5F9FD</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <color name="app_icon_background">#3289FF</color>
</resources>
